      { "id": "q1", "type": "field-change", "fieldName": "Quantity", "value": "5", "previousValue": "", "inputSource": "input", "controlType": "input", "role": "textbox" },
      { "id": "q2", "type": "field-change", "fieldName": "Quantity", "value": "50", "previousValue": "", "inputSource": "input", "controlType": "input", "role": "textbox" },
      { "id": "q3", "type": "field-change", "fieldName": "Quantity", "value": "500", "previousValue": "", "inputSource": "change", "controlType": "input", "role": "textbox", "screenshot": "quantity.png" }
    ], "expected": { "normalizedEvents": 1, "groups": 1, "tasks": [{ "taskType": "EnterQuantity", "fieldCaption": "Quantity", "selectedCaption": "500", "instructionIncludes": ["500", "Quantity"], "screenshot": "quantity.png" }] } },
