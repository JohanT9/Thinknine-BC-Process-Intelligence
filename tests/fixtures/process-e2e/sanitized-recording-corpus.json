      { "id": "m2", "type": "click", "category": "action", "label": "Functions", "accessibleName": "Functions", "role": "button", "controlType": "button", "screenshot": "functions.png" },
      { "id": "m3", "type": "click", "category": "action", "label": "Manual Price...", "accessibleName": "Manual Price...", "role": "button", "controlType": "button", "screenshot": "manual-price.png" }
