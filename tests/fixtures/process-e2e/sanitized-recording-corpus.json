    { "id": "separate-field-interactions-remain-separate", "events": [
      { "id": "i1", "type": "field-change", "fieldName": "Quantity", "accessibleName": "Quantity", "value": "5", "previousValue": "", "inputSource": "input", "interactionId": "quantity-1", "controlType": "input" },
      { "id": "i2", "type": "field-change", "fieldName": "Quantity", "accessibleName": "Quantity", "value": "50", "previousValue": "5", "inputSource": "input", "interactionId": "quantity-2", "controlType": "input" }
    ], "expected": { "normalizedEvents": 2, "groups": 2, "tasks": [{ "taskType": "EnterQuantity", "selectedCaption": "5", "instructionIncludes": ["5", "Quantity"] }, { "taskType": "EnterQuantity", "selectedCaption": "50", "instructionIncludes": ["50", "Quantity"] }] } },
    { "id": "control-addin-action", "events": [{ "id": "ca1", "type": "click", "category": "interaction", "label": "Synthetic surface action", "accessibleName": "Synthetic surface action", "controlType": "div", "reactInteractive": true, "controlAddIn": true, "screenshot": "control-addin.png" }], "expected": { "normalizedEvents": 1, "groups": 1, "tasks": [{ "taskType": "RunAction", "instructionIncludes": ["Synthetic surface action"], "screenshot": "control-addin.png" }] } },
    { "id": "unchecked-toggle-is-preserved", "events": [{ "id": "u1", "type": "click", "label": "Backorder", "accessibleName": "Backorder", "checked": false, "inputType": "checkbox", "controlType": "input", "screenshot": "backorder-off.png" }], "expected": { "normalizedEvents": 1, "groups": 1, "tasks": [{ "taskType": "DisableCheckbox", "fieldCaption": "Backorder", "instructionIncludes": ["Backorder"], "screenshot": "backorder-off.png" }] } },
    { "id": "save-and-close-remains-action", "events": [{ "id": "sc1", "type": "click", "category": "action", "label": "Save and close", "accessibleName": "Save and close", "role": "button", "controlType": "button", "screenshot": "save-close.png" }], "expected": { "normalizedEvents": 1, "groups": 1, "tasks": [{ "taskType": "RunAction", "actionCaption": "Save and close", "instructionIncludes": ["Save and close"], "screenshot": "save-close.png" }] } }
