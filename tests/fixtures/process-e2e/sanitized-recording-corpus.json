    ], "expected": { "normalizedEvents": 2, "groups": 1, "tasks": [{ "taskType": "RunAction", "actionCaption": "Open", "instructionIncludes": ["Open"], "screenshot": "sales-order.png", "resultStatus": "verified" }] } },
