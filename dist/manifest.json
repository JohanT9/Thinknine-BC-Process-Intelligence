{
  "manifest_version": 3,
  "name": "BC Process Studio",
  "version": "4.7.0",
  "description": "Business Process Intelligence for Microsoft Dynamics 365 Business Central. Capture, review and document real processes.",
  "permissions": [
    "activeTab",
    "downloads",
    "identity",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs",
    "unlimitedStorage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://businesscentral.dynamics.com/*",
    "https://*.businesscentral.dynamics.com/*",
    "https://login.microsoftonline.com/*",
    "https://api.applicationinsights.io/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "BC Process Recorder — BC Process Studio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "dashboard.html",
  "content_scripts": [
    {
      "matches": [
        "https://businesscentral.dynamics.com/*",
        "https://*.businesscentral.dynamics.com/*"
      ],
      "js": [
        "capture-focus-session.js",
        "capture-surface-mode.js",
        "bc-error-detector.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "knowledge-packs/*.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
